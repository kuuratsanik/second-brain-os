{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/build_all.py)",
      "Bash(python3 tools/check_kit.py)",
      "Bash(python3 tools/check_kit.py --selftest)",
      "Bash(python3 tools/doc_links.py)",
      "Bash(python3 tools/doc_links.py --selftest)",
      "Bash(python3 -m unittest discover -s tests -t .)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
